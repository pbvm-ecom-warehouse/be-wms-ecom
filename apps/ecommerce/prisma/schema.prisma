// ============================================================
// Ecommerce — ecom_db (1 trong 2 logical DB, cùng cluster với wms_db)
// Sở hữu: catalog / order / auth-ecom
// Liên kết sang WMS CHỈ qua `sku` + id tham chiếu (fulfillWarehouseId/printJobId) — không đọc chéo.
// availableQty là BẢN COPY do WMS sync qua event stock.changed (match theo sku).
// Nguồn: docs/overview/erd.dbml + data-ownership.md
// ============================================================

datasource db {
  provider = "mongodb"
  url      = env("ECOM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// ========================= ENUMS =========================
enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum FulfillmentType {
  STANDARD
  PRINTED_TEMPLATE
  CUSTOM_PRINT
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUND_PENDING
  REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  CANCELLED
  CLOSED
}

enum FulfillmentStatus {
  NONE
  AWAITING_PRINT
  READY_TO_PICK
  ISSUED
  SHIPPED
  DELIVERED
  RETURNED
}

enum TxnType {
  CHARGE
  REFUND
  COD_COLLECT
}

enum TxnStatus {
  SUCCESS
  FAILED
  PENDING
}

enum CustomerStatus {
  ACTIVE
  LOCKED
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ===================== COMPOSITE TYPES =====================
type Address {
  label     String?
  recipient String?
  phone     String?
  line      String
  ward      String?
  district  String?
  province  String?
  isDefault Boolean @default(false)
}

// ======================= Catalog (master) =======================
model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  parentId  String?   @db.ObjectId // null = gốc
  position  Int       @default(0)
  createdBy String?   @db.ObjectId // admin user (cross-app)
  updatedBy String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String        @unique
  description String?
  images      String[]
  categoryId  String?       @db.ObjectId
  status      ProductStatus @default(DRAFT)
  seo         Json?
  createdBy   String?       @db.ObjectId // admin user (cross-app)
  updatedBy   String?       @db.ObjectId
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@map("products")
}

model ProductVariant {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  productId       String          @db.ObjectId
  sku             String          @unique // khớp WMS — khóa sync tồn
  attributes      Json?
  price           Float
  availableQty    Int             @default(0) // bản copy WMS sync (Σ available mọi kho)
  fulfillmentType FulfillmentType @default(STANDARD)
  isActive        Boolean         @default(true)
  createdBy       String?         @db.ObjectId
  updatedBy       String?         @db.ObjectId
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@map("product_variants")
}

model Design {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId String    @db.ObjectId // owner = createdBy
  name       String
  file       String
  thumbnail  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  deletedAt  DateTime?

  @@map("designs")
}

// =========================== Order ===========================
model Cart {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  customerId String     @db.ObjectId
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  cartId      String  @db.ObjectId
  sku         String
  quantity    Int
  isPrintItem Boolean @default(false)
  designFile  String?
  designId    String? @db.ObjectId

  @@map("cart_items")
}

// Hủy bằng orderStatus=CANCELLED (không soft-delete). 3 trục trạng thái độc lập.
model Order {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  code               String            @unique
  customerId         String            @db.ObjectId // người đặt = createdBy
  shippingAddress    Json // snapshot lúc đặt
  subtotal           Float
  shippingFee        Float             @default(0)
  total              Float
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus     @default(UNPAID)
  orderStatus        OrderStatus       @default(PLACED)
  fulfillmentStatus  FulfillmentStatus @default(NONE)
  fulfillWarehouseId String?           @db.ObjectId // CROSS-APP ref → wms warehouses.id (1 kho/đơn)
  hasPrintItems      Boolean           @default(false)
  paymentDeadline    DateTime?
  cancelReason       String?
  updatedBy          String?           @db.ObjectId // admin user / system (cross-app)
  placedAt           DateTime          @default(now()) // = createdAt
  updatedAt          DateTime          @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String  @db.ObjectId
  sku         String
  name        String // snapshot
  unitPrice   Float // snapshot
  quantity    Int
  isPrintItem Boolean @default(false)
  designFile  String?
  designId    String? @db.ObjectId
  printJobId  String? @db.ObjectId // CROSS-APP ref → wms print_jobs.id

  @@map("order_items")
}

// SỔ CÁI tiền append-only. Order.paymentStatus là cache dẫn xuất. BẤT BIẾN.
model PaymentTransaction {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String        @db.ObjectId
  type           TxnType
  status         TxnStatus
  method         PaymentMethod
  amount         Float // luôn dương; hướng tiền suy từ type
  providerTxnId  String?       @unique // idempotency callback cổng
  idempotencyKey String?
  gatewayPayload Json?
  createdBy      String?       @db.ObjectId
  createdAt      DateTime      @default(now())

  @@map("payment_transactions")
}

// ========================= Auth-Ecom =========================
model Customer {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  email         String         @unique
  passwordHash  String
  name          String?
  phone         String?
  emailVerified Boolean        @default(false)
  status        CustomerStatus @default(ACTIVE)
  addresses     Address[] // đúng 1 isDefault=true
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@map("customers")
}

model CustomerRefreshToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId String    @db.ObjectId
  tokenHash  String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@map("customer_refresh_tokens")
}

model CustomerAuthToken {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  customerId String        @db.ObjectId
  type       AuthTokenType
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime? // một-lần
  createdAt  DateTime      @default(now())

  @@map("customer_auth_tokens")
}
