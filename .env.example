# =====================================================================
# WMS-ECOM — mẫu biến môi trường. Copy sang .env rồi điền giá trị thật.
#   cp .env.example .env
# .env KHÔNG commit (đã nằm trong .gitignore).
#
# 2 logical DB trên CÙNG 1 MongoDB cluster (khác tên db ở cuối URL).
# MongoDB cần REPLICA SET để dùng transaction (idempotency consumer + saga).
# Local: docker compose up -d (đã cấu hình rs0 sẵn). Atlas: có sẵn replica set.
# =====================================================================

# Môi trường: development | test | production
NODE_ENV=development

# ---- MongoDB (cùng cluster, khác database) ----
# Local replica set rs0 (theo docker-compose.yml):
WMS_DATABASE_URL=mongodb://localhost:27017/wms_db?replicaSet=rs0
ECOM_DATABASE_URL=mongodb://localhost:27017/ecom_db?replicaSet=rs0

# ---- Redis (BullMQ — hàng đợi event đồng bộ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Production BẮT BUỘC đặt; local có thể để trống.
REDIS_PASSWORD=

# ---- Firebase Admin (Google login / notification) — TỪ ENV, không đọc file ----
# Lấy từ service account JSON (Firebase Console → Project settings → Service accounts).
# Cần ĐỦ 3 biến mới bật; thiếu thì Firebase tắt (không lỗi). private_key giữ nguyên
# ký tự \n (literal), bọc trong nháy kép — code tự đổi \n thành xuống dòng thật.
FIREBASE_PROJECT_ID=wms-ecom
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wms-ecom.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Email (Resend) — thiếu thì email tắt mềm ----
RESEND_API_KEY=
RESEND_FROM=WMS Shop <no-reply@your-domain.com>

# ---- Auth: mỗi app secret RIÊNG, ≥32 ký tự, KHÔNG trùng nhau ----
# Sinh secret mạnh:  openssl rand -base64 48
WMS_JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-AAAA
WMS_JWT_EXPIRES_IN=8h
WMS_REFRESH_EXPIRES_IN=30d
ECOM_JWT_SECRET=thay-bang-chuoi-ngau-nhien-KHAC-toi-thieu-32-ky-tu-BBBB
ECOM_JWT_EXPIRES_IN=30d
ECOM_REFRESH_EXPIRES_IN=60d

# ---- CORS: danh sách origin được phép (ngăn cách dấu phẩy) ----
# Để trống ở dev = phản chiếu mọi origin; production BẮT BUỘC khai báo.
WMS_CORS_ORIGINS=http://localhost:5173
ECOM_CORS_ORIGINS=http://localhost:3000

# ---- Ports ----
WMS_PORT=3001
ECOM_PORT=3002
NOTIFICATION_PORT=3000

# ---- Logging & throttle (chuẩn cross-cutting, áp cho cả 3 app) ----
# LOG_LEVEL: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Throttle mặc định toàn cục (route auth tự áp mức chặt 5/60s trong code).
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=100
