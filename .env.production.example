# =====================================================================
# Mẫu biến môi trường PRODUCTION (DO VPS). Copy sang .env rồi điền giá trị thật.
#   Mongo = Atlas (managed)   |   Redis = Docker local trên VPS (docker-compose.prod.yml)
# =====================================================================

NODE_ENV=production

# ---- MongoDB: Atlas (connection string SRV, replica set có sẵn) ----
# Lấy ở Atlas → Connect → Drivers. CHỌN CLUSTER GẦN REGION VPS (vd Singapore).
# 2 logical DB khác tên ở cuối path (/wms_db, /ecom_db) trên CÙNG cluster.
WMS_DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.xxxx.mongodb.net/wms_db?retryWrites=true&w=majority
ECOM_DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.xxxx.mongodb.net/ecom_db?retryWrites=true&w=majority

# ---- Redis: Docker local trên VPS ----
# App chạy PM2/host → localhost. App chạy Docker chung network → đổi thành 'redis'.
REDIS_HOST=localhost
REDIS_PORT=6379
# BẮT BUỘC ở prod (compose.prod fail nếu trống). Sinh: openssl rand -base64 32
REDIS_PASSWORD=

# ---- Firebase Admin (Google login / notification) ----
FIREBASE_ADMIN_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
FIREBASE_PROJECT_ID=wms-ecom

# ---- Auth: secret RIÊNG mỗi app, ≥32 ký tự, KHÁC nhau ----
WMS_JWT_SECRET=
WMS_JWT_EXPIRES_IN=8h
WMS_REFRESH_EXPIRES_IN=30d
ECOM_JWT_SECRET=
ECOM_JWT_EXPIRES_IN=30d
ECOM_REFRESH_EXPIRES_IN=60d

# ---- CORS: prod BẮT BUỘC khai báo origin thật (không để trống) ----
WMS_CORS_ORIGINS=https://admin.your-domain.com
ECOM_CORS_ORIGINS=https://shop.your-domain.com

# ---- Ports ----
WMS_PORT=3001
ECOM_PORT=3002
NOTIFICATION_PORT=3000

# ---- Logging & throttle ----
LOG_LEVEL=info
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=100
